# SPDX-License-Identifier: BSD-3-Clause
# Copie para .env e ajuste. Nenhuma variável é obrigatória: sem chave de IA o NEXUS
# usa o modo offline (base de conhecimento local).

POSTGRES_PASSWORD=troque_esta_senha

# Carrega o ambiente de demonstração (NexusBank) na primeira execução
SEED_DEMO=true

# IA: auto | openai | ollama | offline
AI_PROVIDER=auto

# OpenAI (GPT-4o / GPT-4.1)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Modelo local para ambientes com restrição de privacidade (Llama 3 / Mistral via Ollama)
# Ex.: OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_URL=
OLLAMA_MODEL=llama3
